# ── AI model (pluggable via LiteLLM) ─────────────────────────────────────────
# Pick any provider LiteLLM supports. Examples:
#   anthropic  + claude-sonnet-4-6
#   openai     + gpt-4o
#   gemini     + gemini-1.5-pro
#   groq       + llama-3.3-70b-versatile
#   ollama     + llama3.1        (local; set LLM_BASE_URL=http://localhost:11434)
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-6
# API key for the chosen provider. If left blank, LiteLLM falls back to the
# provider's own env var (e.g. ANTHROPIC_API_KEY below), so existing setups work.
LLM_API_KEY=
# Only for OpenAI-compatible / local endpoints (Ollama, LM Studio, OpenRouter…).
LLM_BASE_URL=

# Persona methodology: generic (default) | custom. Usually set in-app via
# onboarding/settings (incl. an "describe it, the LLM drafts it" builder) rather
# than here. Env vars are a fallback; app config (config_blobs) takes precedence.
COACH_METHODOLOGY=generic
COACH_METHODOLOGY_TEXT=
COACH_METHODOLOGY_FILE=
DIETITIAN_METHODOLOGY=generic
DIETITIAN_METHODOLOGY_TEXT=

# Backward-compatible provider key fallback (used if LLM_API_KEY is blank):
ANTHROPIC_API_KEY=sk-ant-...

# ── Auth ─────────────────────────────────────────────────────────────────────
# Required in production. Sessions are signed with this — set a long random value.
# Generate one: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# Auth mode: password (default) | oauth | none
#   password → single shared password gate, no external account needed.
#   oauth    → Google sign-in restricted to ALLOWED_EMAILS (needs a Google project).
#   none     → no auth at all; local dev / public demo ONLY.
# If left blank, defaults to oauth when GOOGLE_CLIENT_ID is set, else password.
AUTH_MODE=password
# Password for AUTH_MODE=password:
APP_PASSWORD=change-me
# For AUTH_MODE=oauth only:
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ALLOWED_EMAILS=you@example.com

# ── Activity source: Strava (optional) ───────────────────────────────────────
# Create an app at https://www.strava.com/settings/api, then run scripts/strava_setup.py
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REFRESH_TOKEN=
STRAVA_WEBHOOK_VERIFY_TOKEN=

# ── Database (optional) ──────────────────────────────────────────────────────
# Leave blank to use local SQLite. Set to a Postgres URL (e.g. Neon) for cloud.
DATABASE_URL=

# ── Rate limiting (protects your API key on a public/demo instance) ──────────
# Per-minute LLM-call budget per client IP, plus a global ceiling. Generous
# defaults so a single self-hoster never notices. Set RATE_LIMIT_PER_MIN=0 to
# disable. For a public demo, tighten these (e.g. 6 / 40).
RATE_LIMIT_PER_MIN=20
RATE_LIMIT_GLOBAL_PER_MIN=120

# ── Demo mode (optional) ─────────────────────────────────────────────────────
# Set to 1 to seed a generic example athlete/goal/course on first boot (for a
# public "try it" demo). Leave blank so a fresh install starts empty and runs
# the onboarding wizard instead.
SEED_DEMO_DATA=

# ── Activity source: Garmin (optional, advanced) ─────────────────────────────
GARMIN_EMAIL=
GARMIN_PASSWORD=
